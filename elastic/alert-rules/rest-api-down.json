{
  "name": "Stouter: Subscribe REST API Crashed",
  "tags": ["stouter", "service-mesh", "critical"],
  "rule_type_id": ".es-query",
  "consumer": "alerts",
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "index": ["logs-stouter-*"],
    "timeField": "@timestamp",
    "size": 100,
    "threshold": [1],
    "thresholdComparator": ">=",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "searchType": "esQuery",
    "excludeHitsFromPreviousRun": true,
    "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"match_phrase\":{\"message\":\"REST API server exited\"}}]}}}"
  },
  "actions": [],
  "enabled": true
}
